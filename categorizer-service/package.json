{
  "name": "@move/categorizer-service",
  "version": "1.0.0",
  "scripts": {
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src --ext .ts",
    "evaluate:r10": "npm run build && node dist/evaluation/run.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@move/shared": "*",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
