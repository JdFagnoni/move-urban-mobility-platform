    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": ["{{gateway_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create Test Vehicle (capacity 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('has id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('vehicleId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"F12-TEST-001\",\n  \"type\": \"van\",\n  \"capacity\": 10,\n  \"status\": \"available\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/vehicles",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "vehicles"]
            }
          },
          "response": []
        },
        {
          "name": "Create Small Vehicle (capacity 1)",
          "event": [
