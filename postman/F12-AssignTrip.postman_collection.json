            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"F12-MAINT-001\",\n  \"type\": \"van\",\n  \"capacity\": 5,\n  \"status\": \"maintenance\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/vehicles",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "vehicles"]
            }
          },
          "response": []
        },
        {
          "name": "List Driver Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('has drivers', () => pm.expect(body.data.data.length).to.be.greaterThan(0));",
                  "const driver = body.data.data.find(u => u.role === 'driver' && u.status === 'active');",
                  "pm.test('found active driver', () => pm.expect(driver).to.not.be.undefined);",
                  "if (driver) pm.collectionVariables.set('driverId', driver.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/reservations/users?role=driver&status=active",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "users"],
              "query": [
                { "key": "role", "value": "driver" },
                { "key": "status", "value": "active" }
              ]
            }
          },
          "response": []
        }
      ]
