    {
      "name": "Happy Paths",
      "item": [
        {
          "name": "[HP-1] Assign Vehicle and Driver (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('status is assigned', () => pm.expect(body.data.status).to.eql('assigned'));",
                  "pm.test('vehicleId set', () => pm.expect(body.data.vehicleId).to.eql(pm.collectionVariables.get('vehicleId')));",
                  "pm.test('driverId set', () => pm.expect(body.data.driverId).to.eql(pm.collectionVariables.get('driverId')));",
                  "pm.test('has cargoItems', () => pm.expect(body.data.cargoItems).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"driverId\": \"{{driverId}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/reservations/{{reservationId}}/assign",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "reservations", "{{reservationId}}", "assign"]
            }
          },
          "response": []
        },
        {
          "name": "[HP-2] Assign with Operator Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set reservationId to a DIFFERENT confirmed reservation before running this test.",
                  "// The one used in HP-1 is now in 'assigned' status and will return 409."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('status is assigned', () => pm.expect(body.data.status).to.eql('assigned'));",
                  "pm.collectionVariables.set('secondReservationId', pm.collectionVariables.get('reservationId'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{operatorToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"driverId\": \"{{driverId}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/reservations/{{reservationId}}/assign",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "reservations", "{{reservationId}}", "assign"]
            }
          },
          "response": []
        }
      ]
