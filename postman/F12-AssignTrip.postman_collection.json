        {
          "name": "[BRV-5] Vehicle Schedule Conflict",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Pre-condition: vehicleId is already assigned to {{reservationId}} (done in HP-1).",
                  "// secondReservationId must be a DIFFERENT confirmed reservation",
                  "// with scheduledAt within 2h of reservationId's scheduledAt.",
                  "// Set secondReservationId collection variable before running."
                ],
