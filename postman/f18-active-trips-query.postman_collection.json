            "pm.test('success true', () => pm.expect(body.success).to.be.true);",
            "pm.test('data es array', () => pm.expect(body.data).to.be.an('array'));",
            "const trip = body.data.find(t => t.id === pm.collectionVariables.get('trip_id'));",
            "pm.test('El traslado sin alertas NO aparece con filtro hasActiveAlerts=true', () => pm.expect(trip).to.be.undefined);",
            "pm.test('Todos los resultados tienen alertas activas', () => {",
            "  body.data.forEach(t => pm.expect(t.hasActiveAlerts).to.be.true);",
            "});"
          ]}}]
        },
        {
          "name": "T07 – Filtros combinados (vehicleId + driverId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operator_token}}" }],
            "url": {
              "raw": "{{base_url}}/transportations-service/operator/trips/active?vehicleId={{vehicle_id}}&driverId={{driver_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["transportations-service","operator","trips","active"],
              "query": [
                { "key": "vehicleId", "value": "{{vehicle_id}}" },
                { "key": "driverId",  "value": "{{driver_user_id}}" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));",
            "const body = pm.response.json();",
            "pm.test('success true', () => pm.expect(body.success).to.be.true);",
            "const trip = body.data.find(t => t.id === pm.collectionVariables.get('trip_id'));",
            "pm.test('El traslado aparece con filtros combinados', () => pm.expect(trip).to.not.be.undefined);"
          ]}}]
        },
        {
          "name": "T08 – vehicleId inexistente → lista vacía",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operator_token}}" }],
            "url": {
              "raw": "{{base_url}}/transportations-service/operator/trips/active?vehicleId={{nonexistent_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["transportations-service","operator","trips","active"],
              "query": [{ "key": "vehicleId", "value": "{{nonexistent_uuid}}" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));",
            "const body = pm.response.json();",
            "pm.test('success true', () => pm.expect(body.success).to.be.true);",
            "pm.test('Lista vacía para UUID inexistente', () => pm.expect(body.data).to.eql([]));"
          ]}}]
        },
        {
          "name": "T09 – Error 403: conductor intenta acceder como operador",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
            "url": "{{base_url}}/transportations-service/operator/trips/active"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403', () => pm.expect(pm.response.code).to.eql(403));",
            "const body = pm.response.json();",
            "pm.test('success false', () => pm.expect(body.success).to.be.false);",
            "pm.test('Error mensaje presente', () => pm.expect(body.error).to.be.a('string').and.not.empty);"
          ]}}]
        }
      ]
    }
  ]
}
