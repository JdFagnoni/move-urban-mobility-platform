    {
      "name": "F18 – Consultar Traslados en Curso",
      "item": [
        {
          "name": "T01 – Sin filtros (todos los traslados activos)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operator_token}}" }],
            "url": "{{base_url}}/transportations-service/operator/trips/active"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));",
            "const body = pm.response.json();",
            "pm.test('success true', () => pm.expect(body.success).to.be.true);",
            "pm.test('data es array', () => pm.expect(body.data).to.be.an('array'));",
            "const trip = body.data.find(t => t.id === pm.collectionVariables.get('trip_id'));",
            "pm.test('El traslado creado aparece en resultados', () => pm.expect(trip).to.not.be.undefined);",
            "pm.test('Tiene campo origin', () => pm.expect(trip.origin).to.exist);",
            "pm.test('Tiene campo destination', () => pm.expect(trip.destination).to.exist);",
            "pm.test('Tiene campo vehicle con plate', () => pm.expect(trip.vehicle.plate).to.be.a('string'));",
            "pm.test('Tiene campo driver con name', () => pm.expect(trip.driver.name).to.be.a('string'));",
            "pm.test('Tiene campo hasActiveAlerts (boolean)', () => pm.expect(trip.hasActiveAlerts).to.be.a('boolean'));",
            "pm.test('Status no es completed ni cancelled', () => pm.expect(['completed','cancelled']).to.not.include(trip.status));"
          ]}}]
        },
        {
          "name": "T02 – Filtro por vehicleId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operator_token}}" }],
            "url": {
              "raw": "{{base_url}}/transportations-service/operator/trips/active?vehicleId={{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["transportations-service","operator","trips","active"],
              "query": [{ "key": "vehicleId", "value": "{{vehicle_id}}" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));",
            "const body = pm.response.json();",
            "pm.test('success true', () => pm.expect(body.success).to.be.true);",
            "pm.test('data es array', () => pm.expect(body.data).to.be.an('array'));",
            "const trip = body.data.find(t => t.id === pm.collectionVariables.get('trip_id'));",
            "pm.test('El traslado aparece en resultados filtrados por vehicleId', () => pm.expect(trip).to.not.be.undefined);",
            "pm.test('Todos los resultados tienen el vehicleId correcto', () => {",
            "  body.data.forEach(t => pm.expect(t.vehicle.id).to.eql(pm.collectionVariables.get('vehicle_id')));",
            "});"
          ]}}]
        },
        {
          "name": "T03 – Filtro por driverId",
