    {
      "name": "Zones CRUD",
      "item": [
        {
          "name": "Create Red Zone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('has id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.test('type is red', () => pm.expect(body.data.type).to.eql('red'));",
                  "pm.collectionVariables.set('zoneId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zona Roja Centro\",\n  \"type\": \"red\",\n  \"polygon\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [-56.1645, -34.9050],\n        [-56.1600, -34.9050],\n        [-56.1600, -34.9015],\n        [-56.1645, -34.9015],\n        [-56.1645, -34.9050]\n      ]\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/zones",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "zones"]
            }
          },
          "response": []
        },
        {
          "name": "Create Preferred Zone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('type is preferred', () => pm.expect(body.data.type).to.eql('preferred'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zona Preferente Rambla\",\n  \"type\": \"preferred\",\n  \"polygon\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [-56.1880, -34.9060],\n        [-56.1820, -34.9060],\n        [-56.1820, -34.9020],\n        [-56.1880, -34.9020],\n        [-56.1880, -34.9060]\n      ]\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/zones",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "zones"]
            }
          },
          "response": []
        },
        {
          "name": "List Zones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));",
                  "if (body.data.length > 0) {",
                  "  pm.test('zone has id, name, type, polygon', () => {",
                  "    const z = body.data[0];",
                  "    pm.expect(z.id).to.be.a('string');",
                  "    pm.expect(z.name).to.be.a('string');",
                  "    pm.expect(['red','preferred']).to.include(z.type);",
                  "    pm.expect(z.polygon).to.have.property('type', 'Polygon');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/reservations/zones",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "zones"]
            }
          },
          "response": []
        },
        {
