    {
      "name": "F15-F16 - Alerts",
      "description": "Pruebas de detección de situaciones y generación de alertas.\nRequiere que el Setup haya creado el vehículo (vehicleId) y la zona roja (zoneId).",
      "item": [
        {
          "name": "Geofence",
          "description": "Enviar señal DENTRO de la zona roja para disparar alerta de geofence.",
          "item": [
            {
              "name": "Señal DENTRO de Zona Roja → dispara alerta geofence",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('ts_now', new Date().toISOString());"
                    ],
                    "type": "text/javascript"
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                      "const body = pm.response.json();",
                      "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                      "console.log('Signal inside red zone sent. Check GET /alerts in ~1s.');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1882, -34.9065]\n  },\n  \"speed\": 20.0,\n  \"heading\": 180.0,\n  \"timestamp\": \"{{ts_now}}\"\n}"
                },
                "url": {
                  "raw": "{{transport_url}}/gps/signal",
                  "host": ["{{transport_url}}"],
                  "path": ["gps", "signal"]
                }
              },
              "response": []
            },
            {
              "name": "Verificar Alerta Geofence Generada",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                      "pm.test('has alerts', () => pm.expect(body.data.length).to.be.greaterThan(0));",
                      "const geofenceAlert = body.data.find(a => a.type === 'geofence_exit');",
                      "pm.test('geofence_exit alert exists', () => pm.expect(geofenceAlert).to.not.be.undefined);",
                      "pm.test('severity is critical', () => pm.expect(geofenceAlert.severity).to.eql('critical'));",
                      "pm.test('not resolved', () => pm.expect(geofenceAlert.resolvedAt).to.be.undefined);",
                      "if (geofenceAlert) {",
                      "  pm.collectionVariables.set('alertId', geofenceAlert.id);",
                      "  console.log('alertId saved:', geofenceAlert.id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gateway_url}}/transportations/alerts?vehicleId={{vehicleId}}&resolved=false",
                  "host": ["{{gateway_url}}"],
                  "path": ["transportations", "alerts"],
                  "query": [
                    { "key": "vehicleId", "value": "{{vehicleId}}" },
                    { "key": "resolved", "value": "false" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Segunda Señal en Zona Roja → NO duplica alerta",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('ts_now', new Date().toISOString());"
                    ],
                    "type": "text/javascript"
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                      "console.log('Second signal sent. Alert should NOT be duplicated.');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1880, -34.9060]\n  },\n  \"speed\": 15.0,\n  \"heading\": 180.0,\n  \"timestamp\": \"{{ts_now}}\"\n}"
                },
                "url": {
                  "raw": "{{transport_url}}/gps/signal",
                  "host": ["{{transport_url}}"],
                  "path": ["gps", "signal"]
                }
              },
              "response": []
            },
            {
              "name": "Verificar Sin Duplicados (sigue siendo 1 alerta geofence)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "const geofenceAlerts = body.data.filter(a => a.type === 'geofence_exit');",
                      "pm.test('only 1 geofence alert (no duplicates)', () => pm.expect(geofenceAlerts.length).to.eql(1));"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gateway_url}}/transportations/alerts?vehicleId={{vehicleId}}&resolved=false",
                  "host": ["{{gateway_url}}"],
                  "path": ["transportations", "alerts"],
                  "query": [
                    { "key": "vehicleId", "value": "{{vehicleId}}" },
                    { "key": "resolved", "value": "false" }
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Parada Prolongada",
          "description": "Enviar señales con speed=0 separadas >60s para disparar alerta de delay.\nLos timestamps están backdated 90s y 5s para simular la condición sin esperar.",
          "item": [
            {
              "name": "Señal Stop 1 (speed=0, backdated 90s)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const t1 = new Date(Date.now() - 90000);",
                      "pm.collectionVariables.set('ts_stop1', t1.toISOString());"
                    ],
                    "type": "text/javascript"
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 202', () => pm.response.to.have.status(202));"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1553, -34.8821]\n  },\n  \"speed\": 0,\n  \"heading\": 0.0,\n  \"timestamp\": \"{{ts_stop1}}\"\n}"
                },
                "url": {
                  "raw": "{{transport_url}}/gps/signal",
                  "host": ["{{transport_url}}"],
                  "path": ["gps", "signal"]
                }
              },
              "response": []
            },
            {
              "name": "Señal Stop 2 (speed=0, backdated 5s) → dispara alerta delay",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const t2 = new Date(Date.now() - 5000);",
                      "pm.collectionVariables.set('ts_stop2', t2.toISOString());"
                    ],
                    "type": "text/javascript"
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                      "console.log('Stop signal 2 sent (~85s gap from signal 1). Delay alert should be generated.');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1553, -34.8821]\n  },\n  \"speed\": 0,\n  \"heading\": 0.0,\n  \"timestamp\": \"{{ts_stop2}}\"\n}"
                },
                "url": {
                  "raw": "{{transport_url}}/gps/signal",
                  "host": ["{{transport_url}}"],
                  "path": ["gps", "signal"]
                }
              },
              "response": []
            },
            {
              "name": "Verificar Alerta Delay Generada",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "const delayAlert = body.data.find(a => a.type === 'delay');",
                      "pm.test('delay alert exists', () => pm.expect(delayAlert).to.not.be.undefined);",
                      "pm.test('severity is warning', () => pm.expect(delayAlert.severity).to.eql('warning'));",
                      "pm.test('not resolved', () => pm.expect(delayAlert.resolvedAt).to.be.undefined);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gateway_url}}/transportations/alerts?vehicleId={{vehicleId}}&resolved=false",
                  "host": ["{{gateway_url}}"],
                  "path": ["transportations", "alerts"],
                  "query": [
                    { "key": "vehicleId", "value": "{{vehicleId}}" },
                    { "key": "resolved", "value": "false" }
                  ]
                }
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Alert Management",
      "description": "Gestión de alertas: listar, filtrar y resolver.",
      "item": [
        {
          "name": "Listar Todas las Alertas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
