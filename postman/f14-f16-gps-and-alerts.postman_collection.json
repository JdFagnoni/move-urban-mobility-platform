{
  "info": {
    "_postman_id": "gps-alerts-f14-f15-f16",
    "name": "F14-F16 GPS and Alerts",
    "description": "Pruebas de ingesta GPS (F14), detección de situaciones (F15) y generación de alertas (F16).\n\nFlujo recomendado:\n1. Ejecutar 'Setup' para crear vehículo y zona roja\n2. Ejecutar 'F14 - GPS Ingestion'\n3. Ejecutar 'F15-F16 - Alerts'\n4. Ejecutar 'Alert Management'\n\nNota: Los requests de GPS van directo al transportation-service (port 3002, sin auth).\nLos requests de alerts van por el gateway (port 3000, requieren token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:3000" },
    { "key": "transport_url", "value": "http://localhost:3002" },
    { "key": "adminToken", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "zoneId", "value": "" },
    { "key": "alertId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "description": "Crear vehículo y zona roja. Ejecutar en orden. Requiere adminToken cargado.",
      "item": [
        {
          "name": "1. Crear Vehículo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('vehicle has id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('vehicleId', body.data.id);",
                  "console.log('vehicleId saved:', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"GPS-TEST-01\",\n  \"type\": \"VAN\",\n  \"capacity\": 1000,\n  \"gpsDeviceId\": \"gps-device-test-01\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/vehicles",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "vehicles"]
            }
          },
          "response": []
        },
        {
          "name": "2. Crear Zona Roja (cubre Plaza Independencia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('type is red', () => pm.expect(body.data.type).to.eql('red'));",
                  "pm.collectionVariables.set('zoneId', body.data.id);",
                  "console.log('zoneId saved:', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zona Roja Test - Plaza Independencia\",\n  \"type\": \"red\",\n  \"description\": \"Zona para pruebas de geofencing\",\n  \"polygon\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [[\n      [-56.1900, -34.9080],\n      [-56.1860, -34.9080],\n      [-56.1860, -34.9050],\n      [-56.1900, -34.9050],\n      [-56.1900, -34.9080]\n    ]]\n  }\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/zones",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "zones"]
            }
          },
          "response": []
        },
        {
          "name": "3. Verificar Vehículo Creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id matches', () => pm.expect(body.data.id).to.eql(pm.collectionVariables.get('vehicleId')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/reservations/vehicles/{{vehicleId}}",
              "host": ["{{gateway_url}}"],
              "path": ["reservations", "vehicles", "{{vehicleId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "F14 - GPS Ingestion",
      "description": "Pruebas de ingesta y validación de señales GPS.\nLos requests van directo al transportation-service (sin auth).",
      "item": [
        {
          "name": "Enviar Señal Válida (fuera de zona roja)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('ts_now', new Date().toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1712, -34.8941]\n  },\n  \"speed\": 45.5,\n  \"heading\": 90.0,\n  \"timestamp\": \"{{ts_now}}\"\n}"
            },
            "url": {
              "raw": "{{transport_url}}/gps/signal",
              "host": ["{{transport_url}}"],
              "path": ["gps", "signal"]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Última Señal del Vehículo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('vehicleId matches', () => pm.expect(body.data.vehicleId).to.eql(pm.collectionVariables.get('vehicleId')));",
                  "pm.test('has location', () => pm.expect(body.data.location.type).to.eql('Point'));",
                  "pm.test('has speed', () => pm.expect(body.data.speed).to.be.a('number'));",
                  "pm.test('has timestamp', () => pm.expect(body.data.timestamp).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{transport_url}}/gps/vehicle/{{vehicleId}}/latest",
              "host": ["{{transport_url}}"],
              "path": ["gps", "vehicle", "{{vehicleId}}", "latest"]
            }
          },
          "response": []
        },
        {
          "name": "Señal con VehicleId Inválido - Expect 400",
          "event": [
