                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('manual-flow reservation created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.status).to.eql('pending_classification');",
                  "pm.expect(body.data.cargoItems).to.have.length(2);",
                  "pm.collectionVariables.set('manual_reservation_id', body.data.id);",
                  "pm.collectionVariables.set('manual_cargo_item_id_1', body.data.cargoItems[0].id);",
                  "pm.collectionVariables.set('manual_cargo_item_id_2', body.data.cargoItems[1].id);"
                ]
              }
