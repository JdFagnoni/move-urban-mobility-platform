        {
          "name": "Initialize Run Variables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('gateway health responded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const runId = String(Date.now());",
                  "const futureDate = new Date(Date.now() + 72 * 60 * 60 * 1000).toISOString();",
                  "pm.collectionVariables.set('run_id', runId);",
                  "pm.collectionVariables.set('future_date', futureDate);",
                  "pm.collectionVariables.set('individual_email', `qa-f19-individual-${runId}@move.com`);",
                  "pm.collectionVariables.set('operator_candidate_email', `qa-f19-operator-${runId}@move.com`);",
                  "pm.collectionVariables.set('manual_unknown_desc_1', `f19-unknown-alpha-${runId}`);",
                  "pm.collectionVariables.set('manual_unknown_desc_2', `f19-unknown-beta-${runId}`);",
                  "pm.collectionVariables.set('reject_unknown_desc', `f19-unknown-reject-${runId}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "health"
              ]
            }
