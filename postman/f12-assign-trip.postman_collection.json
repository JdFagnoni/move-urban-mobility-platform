  "variable": [
    { "key": "gateway_url", "value": "http://localhost:3000" },
    { "key": "operatorToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "secondReservationId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "secondVehicleId", "value": "" },
    { "key": "smallVehicleId", "value": "" },
    { "key": "maintenanceVehicleId", "value": "" },
    { "key": "driverId", "value": "" },
    { "key": "adminId", "value": "" }
