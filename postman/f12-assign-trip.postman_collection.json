              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/reservations-service/users?role=admin&status=active",
              "host": ["{{gateway_url}}"],
              "path": ["reservations-service", "users"],
              "query": [
