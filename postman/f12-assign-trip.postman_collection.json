        {
          "name": "Get Active Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "const driver = body.data.data.find(u => u.role === 'driver' && u.status === 'active');",
                  "pm.test('found active driver', () => pm.expect(driver).to.not.be.undefined);",
                  "if (driver) pm.collectionVariables.set('driverId', driver.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/reservations-service/users?role=driver&status=active",
              "host": ["{{gateway_url}}"],
              "path": ["reservations-service", "users"],
              "query": [
                { "key": "role", "value": "driver" },
                { "key": "status", "value": "active" }
              ]
            }
          },
          "response": []
        },
