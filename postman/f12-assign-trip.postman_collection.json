                { "key": "status", "value": "active" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Confirmed Reservations (auto-set reservationId + secondReservationId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "const confirmed = body.data.data.filter(r => r.status === 'confirmed');",
                  "pm.test('at least 2 confirmed reservations exist', () => pm.expect(confirmed.length).to.be.at.least(2));",
                  "if (confirmed.length >= 1) pm.collectionVariables.set('reservationId', confirmed[0].id);",
                  "if (confirmed.length >= 2) pm.collectionVariables.set('secondReservationId', confirmed[1].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations?status=confirmed&pageSize=10",
              "host": ["{{gateway_url}}"],
              "path": ["reservations-service", "reservations"],
              "query": [
                { "key": "status", "value": "confirmed" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          },
          "response": []
        }
      ]
