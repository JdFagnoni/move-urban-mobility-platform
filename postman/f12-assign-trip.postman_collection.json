    {
      "name": "Happy Paths",
      "item": [
        {
          "name": "[HP-1] Assign Vehicle and Driver (admin token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('status is assigned', () => pm.expect(body.data.status).to.eql('assigned'));",
                  "pm.test('vehicleId matches', () => pm.expect(body.data.vehicleId).to.eql(pm.collectionVariables.get('vehicleId')));",
                  "pm.test('driverId matches', () => pm.expect(body.data.driverId).to.eql(pm.collectionVariables.get('driverId')));",
                  "pm.test('cargoItems present', () => pm.expect(body.data.cargoItems).to.be.an('array'));",
                  "pm.test('id present', () => pm.expect(body.data.id).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_auth_token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"driverId\": \"{{driverId}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations/{{reservationId}}/assign",
              "host": ["{{gateway_url}}"],
              "path": ["reservations-service", "reservations", "{{reservationId}}", "assign"]
            }
          },
          "response": []
        },
