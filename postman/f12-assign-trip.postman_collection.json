  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('gateway ok', () => pm.expect(body.status).to.eql('ok'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": ["{{gateway_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Setup",
      "description": "Pre-condition: admin_auth_token must be set in the environment. Confirmed reservations must exist before running (create via F4+F6 flow). This Setup auto-populates vehicleId, secondVehicleId, smallVehicleId, maintenanceVehicleId, driverId, adminId, reservationId, and secondReservationId.",
      "item": [
        {
          "name": "Create Main Vehicle (capacity 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                  "pm.collectionVariables.set('vehicleId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_auth_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"F12-MAIN-001\",\n  \"type\": \"van\",\n  \"capacity\": 10,\n  \"status\": \"available\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/transportations-service/vehicles",
              "host": ["{{gateway_url}}"],
              "path": ["transportations-service", "vehicles"]
            }
          },
          "response": []
        },
