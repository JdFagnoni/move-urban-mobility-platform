    {
      "name": "Business Rule Violations (409)",
      "item": [
        {
          "name": "[BRV-1] Reservation Not in Confirmed Status",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// reservationId was assigned in HP-1 and is now in 'assigned' status.",
                  "// Attempting to assign it again must return 409."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('success is false', () => pm.expect(body.success).to.be.false);",
                  "pm.test('error mentions confirmed status', () => pm.expect(body.error.toLowerCase()).to.include('confirmed'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_auth_token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"driverId\": \"{{driverId}}\"\n}"
            },
