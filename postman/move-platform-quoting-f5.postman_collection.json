        {
          "name": "Initialize Run Variables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('health endpoint responded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const runId = String(Date.now());",
                  "const futureDate = new Date(Date.now() + 48 * 60 * 60 * 1000).toISOString();",
                  "pm.collectionVariables.set('run_id', runId);",
                  "pm.collectionVariables.set('future_date', futureDate);",
                  "pm.collectionVariables.set('company_email', `qa-company-f5-${runId}@move.com`);",
                  "pm.collectionVariables.set('individual_email', `qa-individual-f5-${runId}@move.com`);",
                  "pm.collectionVariables.set('individual_keyword', `f5tag${runId}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
