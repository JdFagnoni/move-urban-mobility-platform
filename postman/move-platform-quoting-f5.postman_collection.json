    {
      "name": "Company Client",
      "item": [
        {
          "name": "Create Standard Reservation - Near Route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('near standard reservation quoted', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.success).to.eql(true);",
                  "pm.expect(body.data.status).to.eql('pending_confirmation');",
                  "pm.expect(body.data.quotedPrice).to.be.a('number').and.greaterThan(0);",
                  "pm.expect(body.data.cargoItems[0].categoryId).to.eql(pm.collectionVariables.get('standard_category_id'));",
                  "pm.collectionVariables.set('company_standard_reservation_id', body.data.id);",
                  "pm.collectionVariables.set('company_standard_quote', String(body.data.quotedPrice));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{company_auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"{{future_date}}\",\n  \"originLocationId\": \"{{company_origin_location_id}}\",\n  \"destinationLocationId\": \"{{company_destination_near_id}}\",\n  \"cargoItems\": [\n    {\n      \"description\": \"Standard cargo F5 {{run_id}}\",\n      \"estimatedValue\": 500,\n      \"size\": \"medium\",\n      \"companyProductId\": \"{{company_standard_product_id}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/reservations/reservations",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations",
                "reservations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Standard Reservation - Near Route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('near standard reservation can be retrieved', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.success).to.eql(true);",
                  "pm.expect(body.data.id).to.eql(pm.collectionVariables.get('company_standard_reservation_id'));",
                  "pm.expect(body.data.status).to.eql('pending_confirmation');",
                  "pm.expect(body.data.quotedPrice).to.eql(Number(pm.collectionVariables.get('company_standard_quote')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{company_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/reservations/reservations/{{company_standard_reservation_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations",
                "reservations",
                "{{company_standard_reservation_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Standard Reservation - Far Route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('far standard reservation quoted', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "const baseQuote = Number(pm.collectionVariables.get('company_standard_quote'));",
                  "pm.expect(body.success).to.eql(true);",
                  "pm.expect(body.data.status).to.eql('pending_confirmation');",
                  "pm.expect(body.data.quotedPrice).to.be.a('number').and.greaterThan(baseQuote);",
                  "pm.collectionVariables.set('company_far_reservation_id', body.data.id);",
                  "pm.collectionVariables.set('company_far_quote', String(body.data.quotedPrice));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{company_auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
