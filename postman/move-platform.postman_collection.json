{
  "info": {
    "name": "move-platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Checks",
      "item": [
        { "name": "api-gateway", "request": { "method": "GET", "url": "{{gateway_url}}/health" } },
        { "name": "reservas-service", "request": { "method": "GET", "url": "{{reservas_url}}/health" } },
        { "name": "traslados-service", "request": { "method": "GET", "url": "{{traslados_url}}/health" } },
        { "name": "categorizer-service", "request": { "method": "GET", "url": "{{categorizer_url}}/health" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/reservas/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"test@move.com\",\"password\":\"Secret123!\",\"name\":\"Test Client\",\"clientType\":\"individual\"}" }
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/reservas/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Auth Audit Logs",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/reservas/auth/audit-logs",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/reservas/users?page=1&pageSize=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:3000" },
    { "key": "reservas_url", "value": "http://localhost:3001" },
    { "key": "traslados_url", "value": "http://localhost:3002" },
    { "key": "categorizer_url", "value": "http://localhost:3003" },
    { "key": "auth_token", "value": "" }
  ]
}
