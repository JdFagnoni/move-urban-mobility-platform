          "name": "Stripe Webhook - Rejected",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = {",
                  "  id: `evt_reject_${Date.now()}`,",
                  "  type: 'payment_intent.payment_failed',",
                  "  data: {",
                  "    object: {",
                  "      id: pm.collectionVariables.get('rejected_provider_payment_id'),",
                  "      status: 'requires_payment_method',",
                  "      payment_method_types: ['card'],",
                  "      last_payment_error: {",
                  "        code: 'card_declined',",
                  "        message: 'Card declined in QA flow'",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "const payloadString = JSON.stringify(payload);",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const signature = CryptoJS.HmacSHA256(`${timestamp}.${payloadString}`, pm.variables.get('stripe_webhook_secret')).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('stripe_payload', payloadString);",
                  "pm.variables.set('stripe_signature', `t=${timestamp},v1=${signature}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected webhook processed', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.expect(pm.response.json().data.payment.status).to.eql('rejected');"
                ]
              }
            }
          ],
