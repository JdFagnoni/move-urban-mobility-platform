            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('operator found', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const operator = body.data.data.find((user) => user.email === pm.collectionVariables.get('operator_email'));",
                  "pm.expect(operator).to.not.be.undefined;",
                  "pm.collectionVariables.set('operator_user_id', operator.id);"
