    {
      "name": "Accepted Flow",
      "item": [
        {
          "name": "Create Reservation - Accepted Flow",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted-flow reservation created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.status).to.eql('pending_classification');",
                  "pm.collectionVariables.set('accepted_reservation_id', body.data.id);",
                  "pm.collectionVariables.set('accepted_cargo_item_id', body.data.cargoItems[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"{{future_date_one}}\",\n  \"origin\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1645, -34.9011]\n  },\n  \"destination\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-56.1882, -34.9033]\n  },\n  \"cargoItems\": [\n    {\n      \"description\": \"fragile {{category_keyword}} accepted\",\n      \"estimatedValue\": 1500,\n      \"size\": \"medium\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations-service",
                "reservations"
              ]
            }
          }
        },
        {
          "name": "Classify Reservation - Accepted Flow",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted-flow classification applied or already completed', function () {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.expect(body.data.status).to.eql('pending_confirmation');",
                  "} else {",
                  "  pm.expect(body.error).to.include(\"pending_classification\");",
                  "  pm.expect(body.error).to.include(\"pending_confirmation\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operator_auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cargoItems\": [\n    {\n      \"cargoItemId\": \"{{accepted_cargo_item_id}}\",\n      \"categoryId\": \"{{category_id}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations/{{accepted_reservation_id}}/classification",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations-service",
                "reservations",
                "{{accepted_reservation_id}}",
                "classification"
              ]
            }
          }
        },
        {
          "name": "Get Reservation - Accepted Flow Ready For Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted-flow reservation ready for payment', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql('pending_confirmation');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations/{{accepted_reservation_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations-service",
                "reservations",
                "{{accepted_reservation_id}}"
              ]
            }
          }
        },
        {
          "name": "Confirm Payment - Start Pending Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payment initiation accepted', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.payment.status).to.eql('pending');",
                  "pm.collectionVariables.set('accepted_payment_id', body.data.payment.id);",
                  "pm.collectionVariables.set('accepted_provider_payment_id', body.data.payment.providerPaymentId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"{{stripe_payment_method_id}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations/{{accepted_reservation_id}}/confirm-payment",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations-service",
                "reservations",
                "{{accepted_reservation_id}}",
                "confirm-payment"
              ]
            }
          }
        },
        {
          "name": "List Accepted Flow Payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payments listed', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data[0].status).to.eql('pending');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations/{{accepted_reservation_id}}/payments",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations-service",
                "reservations",
                "{{accepted_reservation_id}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Stripe Webhook - Accepted",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = {",
                  "  id: `evt_accept_${Date.now()}`,",
                  "  type: 'payment_intent.succeeded',",
                  "  data: {",
                  "    object: {",
                  "      id: pm.collectionVariables.get('accepted_provider_payment_id'),",
                  "      status: 'succeeded',",
                  "      payment_method_types: ['card']",
                  "    }",
                  "  }",
                  "};",
                  "const payloadString = JSON.stringify(payload);",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const signature = CryptoJS.HmacSHA256(`${timestamp}.${payloadString}`, pm.variables.get('stripe_webhook_secret')).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('stripe_payload', payloadString);",
                  "pm.variables.set('stripe_signature', `t=${timestamp},v1=${signature}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted webhook processed', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.expect(pm.response.json().data.payment.status).to.eql('accepted');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": "{{stripe_signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{stripe_payload}}"
            },
            "url": {
              "raw": "{{gateway_url}}/webhooks/stripe",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "webhooks",
                "stripe"
              ]
            }
          }
        },
        {
          "name": "Get Reservation - Confirmed After Accepted Webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reservation confirmed', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql('confirmed');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_auth_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/reservations-service/reservations/{{accepted_reservation_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "reservations-service",
                "reservations",
                "{{accepted_reservation_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rejected Flow",
      "item": [
        {
          "name": "Create Reservation - Rejected Flow",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected-flow reservation created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.status).to.eql('pending_classification');",
                  "pm.collectionVariables.set('rejected_reservation_id', body.data.id);",
                  "pm.collectionVariables.set('rejected_cargo_item_id', body.data.cargoItems[0].id);"
                ]
              }
            }
