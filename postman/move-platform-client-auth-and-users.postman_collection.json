				{
					"name": "Get Auth0 Access Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"grant_type\": \"http://auth0.com/oauth/grant-type/password-realm\",\n    \"username\": \"{{auth0_username}}\",\n    \"password\": \"{{auth0_password}}\",\n    \"audience\": \"{{auth0_audience}}\",\n    \"scope\": \"openid profile email\",\n    \"client_id\": \"{{auth0_client_id}}\",\n    \"client_secret\": \"{{auth0_client_secret}}\",\n    \"realm\": \"{{auth0_realm}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "https://{{auth0_domain}}/oauth/token",
							"protocol": "https",
							"host": [
								"{{auth0_domain}}"
							],
							"path": [
								"oauth",
								"token"
							]
						}
					},
					"response": []
				}
			]
