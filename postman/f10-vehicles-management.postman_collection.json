				{
					"name": "Create Vehicle - normalización minusculas (plate y type → mayúsculas)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('vehicle_id_2', body.data.id);",
									"    pm.test('plate normalizado a mayusculas', () => {",
									"        pm.expect(body.data.plate).to.equal('DEF5678');",
									"    });",
									"    pm.test('type normalizado a mayusculas', () => {",
									"        pm.expect(body.data.type).to.equal('AUTO');",
									"    });",
									"}"
